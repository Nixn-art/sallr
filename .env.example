NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Use a cryptographically random value of at least 32 characters in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=saulr-marketplace
JWT_AUDIENCE=saulr-web
SESSION_TTL_HOURS=8
SECURE_COOKIES=false
# Set behind a trusted reverse proxy only.
TRUST_PROXY=false
